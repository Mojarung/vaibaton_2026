# Имя приложения: используется в логах, заголовке API и на демо-странице.
APP_NAME=Контур

# Префикс для метрик Prometheus.
METRICS_PREFIX=pii

# Каталог с конфигурацией (правила, словари, реестр систем).
CONFIG_DIR=config

# Redis для хранения соответствий маска-оригинал.
REDIS_URL=redis://redis:6379/0

# Ключ шифрования соответствий AES-256-GCM: 32 байта в urlsafe-base64.
# Сгенерировать: uv run python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
VAULT_KEY=

# Ключи систем-потребителей. Имя переменной ключа указывается в
# config/systems.yaml полем api_key_env.
KEY_CRM=change-me-crm
KEY_SUPPORT=change-me-support

# Ключ админ-API для управления системами.
ADMIN_KEY=change-me-admin

# Внешняя LLM (OpenAI-совместимый API). Адрес AlfaGen:
# https://alfagen.alfabank.ru/continue-dev/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Сервер.
WORKERS=4
MAX_CONCURRENT=256
MAX_BODY_BYTES=4194304
LOG_LEVEL=INFO